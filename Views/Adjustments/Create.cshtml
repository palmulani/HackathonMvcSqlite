@model HackathonMvcSqlite.Models.StockAdjustment
@{
    ViewData["Title"] = "New Adjustment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mb-3">Stock Adjustment</h2>
<form asp-action="Create" method="post">
    <div class="mb-2"><label class="form-label">Reference</label><input asp-for="Reference" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Product</label><select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select" required></select></div>
    <div class="mb-2"><label class="form-label">Warehouse</label><select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select" required></select></div>
    <div class="mb-2"><label class="form-label">Counted quantity</label><input asp-for="CountedQuantity" type="number" step="0.01" class="form-control" required /></div>
    <div class="mb-2"><label class="form-label">Reason (optional)</label><input asp-for="Reason" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Apply</button>
    <a href="/Adjustments" class="btn btn-secondary">Cancel</a>
</form>
