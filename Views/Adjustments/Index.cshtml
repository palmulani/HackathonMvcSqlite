@model IEnumerable<HackathonMvcSqlite.Models.StockAdjustment>

@{
    ViewData["Title"] = "Adjustments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">Stock Adjustments</h2>

<form method="get" class="row g-2 mb-3">

    <div class="col-auto">
        @Html.DropDownList("warehouseId", ViewBag.Warehouses as SelectList, "All warehouses",
        new { @class = "form-select form-select-sm" })
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">
            Filter
        </button>
    </div>

    <div class="col-auto">
        <a href="/Adjustments/Create" class="btn btn-success btn-sm">
            <i class="fa fa-plus"></i> New Adjustment
        </a>
    </div>

</form>


<table class="table table-striped table-hover datatable">

    <thead>

        <tr>
            <th>Reference</th>
            <th>Product</th>
            <th>Warehouse</th>
            <th>Previous</th>
            <th>Counted</th>
            <th>Date</th>
            <th width="150">Actions</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var a in Model)
        {
            <tr>

                <td>@a.Reference</td>

                <td>@a.Product?.Name</td>

                <td>@a.Warehouse?.Name</td>

                <td>@a.PreviousQuantity</td>

                <td>@a.CountedQuantity</td>

                <td>@a.CreatedAt.ToLocalTime().ToString("g")</td>

                <td>

                    <a class="btn btn-warning btn-sm"
                           href="/Adjustments/Edit/@a.Id">

                        <i class="fa fa-pen"></i>

                    </a>

                    <a class="btn btn-danger btn-sm"
                           href="/Adjustments/Delete/@a.Id"
                           onclick="return confirm('Delete this adjustment?')">

                        <i class="fa fa-trash"></i>

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>