@model IEnumerable<HackathonMvcSqlite.Models.DeliveryOrder>

@{
    ViewData["Title"] = "Delivery Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">Delivery Orders</h2>

<form method="get" class="row g-2 mb-3">

    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">All</option>
            <option value="0">Draft</option>
            <option value="3">Done</option>
        </select>
    </div>

    <div class="col-auto">
        <select name="warehouseId"
                class="form-select form-select-sm"
                asp-items="ViewBag.Warehouses">

            <option value="">All warehouses</option>

        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">
            <i class="fa fa-filter"></i> Filter
        </button>
    </div>

    <div class="col-auto">
        <a href="/DeliveryOrders/Create"
               class="btn btn-sm btn-success">

            <i class="fa fa-plus"></i> New Delivery Order
        </a>
    </div>

</form>


<table class="table table-sm table-hover datatable">

    <thead>

        <tr>
            <th>Reference</th>
            <th>Customer</th>
            <th>Warehouse</th>
            <th>Status</th>
            <th>Created</th>
            <th width="240">Actions</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var d in Model)
        {

            <tr>

                <td>@d.Reference</td>

                <td>@d.Customer</td>

                <td>@d.Warehouse?.Name</td>

                <td>
                    <span class="badge bg-secondary">
                        @d.Status
                    </span>
                </td>

                <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>

                <td>

                    <a class="btn btn-warning btn-sm me-1"
                           href="/DeliveryOrders/Edit/@d.Id">

                        <i class="fa fa-pen"></i> Edit

                    </a>

                    <a class="btn btn-danger btn-sm me-1"
                           href="/DeliveryOrders/Delete/@d.Id"
                           onclick="return confirm('Delete this order?')">

                        <i class="fa fa-trash"></i> Delete

                    </a>

                    @if (d.Status != HackathonMvcSqlite.Models.DocumentStatus.Done)
                    {

                        <a class="btn btn-success btn-sm"
                               href="/DeliveryOrders/Validate/@d.Id">

                            <i class="fa fa-check"></i> Validate

                        </a>

                    }

                </td>

            </tr>

        }

    </tbody>

</table>