@model HackathonMvcSqlite.Models.Warehouse
@{
    ViewData["Title"] = "Edit Warehouse";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mb-3">Edit Warehouse</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-2"><label class="form-label">Name</label><input asp-for="Name" class="form-control" required /></div>
    <div class="mb-2"><label class="form-label">Code</label><input asp-for="Code" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Location</label><input asp-for="Location" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/Warehouses" class="btn btn-secondary">Cancel</a>
</form>
