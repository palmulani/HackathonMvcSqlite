@model IEnumerable<HackathonMvcSqlite.Models.ProductCategory>

@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">Product Categories</h2>

<p>
    <a href="/Categories/Create" class="btn btn-success">
        <i class="fa fa-plus"></i> Add Category
    </a>
</p>

<table class="table table-sm table-hover datatable">

    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Products</th>
            <th width="150">Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var c in Model)
        {
            <tr>

                <td>@c.Name</td>

                <td>@c.Description</td>

                <td>@(c.Products?.Count ?? 0)</td>

                <td>

                    <a class="btn btn-warning btn-sm"
                           href="/Categories/Edit/@c.Id">

                        <i class="fa fa-pen"></i>

                    </a>

                    <a class="btn btn-danger btn-sm"
                           href="/Categories/Delete/@c.Id"
                           onclick="return confirm('Delete this category?')">

                        <i class="fa fa-trash"></i>

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>