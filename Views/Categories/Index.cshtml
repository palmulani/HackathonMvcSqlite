@model IEnumerable<HackathonMvcSqlite.Models.ProductCategory>
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mb-3">Product Categories</h2>
<p><a href="/Categories/Create" class="btn btn-success">Add Category</a></p>
<td>



</td>
<
    <table class="table table-sm table-hover datatable">
    <thead><tr><th>Name</th><th>Description</th><th>Products</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model) { <tr><td>@c.Name</td><td>@c.Description</td><td>@(c.Products?.Count ?? 0)</td><td><a href="/Categories/Edit/@c.Id">Edit</a></td></tr> }
    </tbody>
</table>
