@model IEnumerable<HackathonMvcSqlite.Models.StockLedgerEntry>
@{
    ViewData["Title"] = "Move History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mb-3">Stock Ledger / Move History</h2>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><select name="documentType" class="form-select form-select-sm"><option value="">All</option><option value="0">Receipt</option><option value="1">Delivery</option><option value="2">Internal</option><option value="3">Adjustment</option></select></div>
    <div class="col-auto">@Html.DropDownList("productId", ViewBag.Products as SelectList, "All products", new { @class = "form-select form-select-sm" })</div>
    <div class="col-auto">@Html.DropDownList("warehouseId", ViewBag.Warehouses as SelectList, "All warehouses", new { @class = "form-select form-select-sm" })</div>
    <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Filter</button></div>
</form>
<table class="table table-sm table-hover datatable">
    <thead><tr><th>Date</th><th>Product</th><th>Type</th><th>In</th><th>Out</th><th>Balance</th><th>Description</th></tr></thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@e.Product?.Name</td>
                <td>@e.DocumentType</td>
                <td>@e.QuantityIn</td>
                <td>@e.QuantityOut</td>
                <td>@e.BalanceAfter</td>
                <td>@e.Description</td>
            </tr>
        }
    </tbody>
</table>
