@model HackathonMvcSqlite.Models.InternalTransfer
@{
    ViewData["Title"] = "New Internal Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mb-3">New Internal Transfer</h2>
<form asp-action="Create" method="post">
    <div class="mb-2"><label class="form-label">Reference</label><input asp-for="Reference" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">From Warehouse</label><select asp-for="SourceWarehouseId" asp-items="ViewBag.Warehouses" class="form-select" required></select></div>
    <div class="mb-2"><label class="form-label">To Warehouse</label><select asp-for="DestinationWarehouseId" asp-items="ViewBag.Warehouses" class="form-select" required></select></div>
    <div class="mb-2"><label class="form-label">Lines (Product, Qty)</label></div>
    @for (var i = 0; i < 5; i++)
    {
        <div class="row g-2 mb-1">
            <div class="col"><select name="productId" class="form-select form-select-sm" asp-items="ViewBag.Products"><option value="">--</option></select></div>
            <div class="col"><input type="number" name="quantity" step="0.01" class="form-control form-control-sm" placeholder="Qty" /></div>
        </div>
    }
    <div class="mt-2"><button type="submit" class="btn btn-primary">Create</button><a href="/InternalTransfers" class="btn btn-secondary ms-2">Cancel</a></div>
</form>
