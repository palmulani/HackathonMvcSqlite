@model HackathonMvcSqlite.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .stats-card {
        border-radius: 14px;
        height: 130px;
        padding: 20px;
        color: white;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-shadow: 0 6px 18px rgba(0,0,0,.1);
        transition: .25s;
    }

        .stats-card:hover {
            transform: translateY(-3px);
        }

    .stats-title {
        font-size: 16px;
        font-weight: 600;
    }

    .stats-value {
        font-size: 32px;
        font-weight: 700;
        margin-top: 6px;
    }

    /* ICON POSITION */

    .stats-icon {
        position: absolute;
        bottom: 15px;
        right: 15px;
        font-size: 30px;
        opacity: .25;
    }

    /* COLORS */

    .card-blue {
        background: linear-gradient(135deg,#2563eb,#1e40af);
    }

    .card-orange {
        background: linear-gradient(135deg,#f59e0b,#d97706);
    }

    .card-cyan {
        background: linear-gradient(135deg,#06b6d4,#0891b2);
    }

    .card-gray {
        background: linear-gradient(135deg,#6b7280,#374151);
    }

    .card-dark {
        background: linear-gradient(135deg,#1f2937,#020617);
    }
</style>


<h2 class="mb-4">Inventory Dashboard</h2>


<!-- FILTER -->

<form method="get" class="row g-2 mb-4">

    <div class="col-auto">

        <select name="documentType" class="form-select form-select-sm">
            <option value="">All types</option>
            <option value="0">Receipts</option>
            <option value="1">Delivery</option>
            <option value="2">Internal</option>
        </select>

    </div>


    <div class="col-auto">

        <select name="status" class="form-select form-select-sm">

            <option value="">All statuses</option>
            <option value="0">Draft</option>
            <option value="1">Waiting</option>
            <option value="2">Ready</option>
            <option value="3">Done</option>
            <option value="4">Canceled</option>

        </select>

    </div>


    <div class="col-auto">

        <select name="warehouseId" class="form-select form-select-sm">

            <option value="">All warehouses</option>

            @foreach (var w in ViewBag.Warehouses as IEnumerable<HackathonMvcSqlite.Models.Warehouse> ?? new List<HackathonMvcSqlite.Models.Warehouse>())
            {
                <option value="@w.Id">@w.Name</option>
            }

        </select>

    </div>


    <div class="col-auto">

        <button type="submit" class="btn btn-primary btn-sm">
            <i class="fa fa-filter"></i> Filter
        </button>

    </div>

</form>


<!-- DASHBOARD CARDS -->

<div class="row g-3 mb-4">

    <div class="col-lg-2 col-md-4 col-sm-6">

        <div class="stats-card card-blue">

            <div class="stats-title">Total Products</div>

            <div class="stats-value">
                @Model.TotalProductsInStock
            </div>

            <i class="fa fa-box stats-icon"></i>

        </div>

    </div>


    <div class="col-lg-2 col-md-4 col-sm-6">

        <div class="stats-card card-orange">

            <div class="stats-title">Low Stock</div>

            <div class="stats-value">
                @Model.LowStockOrOutOfStockCount
            </div>

            <i class="fa fa-exclamation-triangle stats-icon"></i>

        </div>

    </div>


    <div class="col-lg-2 col-md-4 col-sm-6">

        <div class="stats-card card-cyan">

            <div class="stats-title">Pending Receipts</div>

            <div class="stats-value">
                @Model.PendingReceiptsCount
            </div>

            <i class="fa fa-arrow-down stats-icon"></i>

        </div>

    </div>


    <div class="col-lg-2 col-md-4 col-sm-6">

        <div class="stats-card card-gray">

            <div class="stats-title">Pending Deliveries</div>

            <div class="stats-value">
                @Model.PendingDeliveriesCount
            </div>

            <i class="fa fa-truck stats-icon"></i>

        </div>

    </div>


    <div class="col-lg-2 col-md-4 col-sm-6">

        <div class="stats-card card-dark">

            <div class="stats-title">Transfers Scheduled</div>

            <div class="stats-value">
                @Model.InternalTransfersScheduledCount
            </div>

            <i class="fa fa-right-left stats-icon"></i>

        </div>

    </div>

</div>


<!-- TABLE SECTION -->

<div class="row">

    <div class="col-lg-6">

        <div class="card">

            <div class="card-header fw-bold">
                Low Stock Alerts
            </div>

            <div class="card-body p-0">

                <table class="table table-sm table-hover mb-0">

                    <thead>

                        <tr>
                            <th>Product</th>
                            <th>SKU</th>
                            <th>Qty</th>
                            <th>Reorder</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var p in Model.LowStockProducts)
                        {

                            <tr>

                                <td>
                                    <a href="/Products/Stock/@p.ProductId">
                                        @p.Name
                                    </a>
                                </td>

                                <td>@p.Sku</td>

                                <td>@p.TotalQty</td>

                                <td>@p.ReorderLevel</td>

                            </tr>

                        }

                        @if (!Model.LowStockProducts.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-muted">
                                    No low stock items
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="card">

            <div class="card-header fw-bold">
                Recent Documents
            </div>

            <div class="card-body p-0">

                <table class="table table-sm table-hover mb-0">

                    <thead>

                        <tr>

                            <th>Type</th>
                            <th>Reference</th>
                            <th>Status</th>
                            <th>Warehouse</th>
                            <th>Date</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var d in Model.RecentDocuments)
                        {

                            <tr>

                                <td>@d.Type</td>

                                <td>@d.Reference</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @d.Status
                                    </span>
                                </td>

                                <td>@d.Warehouse</td>

                                <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>

                            </tr>

                        }

                        @if (!Model.RecentDocuments.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-muted">
                                    No documents yet
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>