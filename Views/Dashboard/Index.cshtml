<div class="row g-3">

    <div class="col-md">

        <div class="stats-card card-blue">

            <h6>Total Products</h6>

            <h2>@Model.TotalProductsInStock</h2>

        </div>

    </div>


    <div class="col-md">

        <div class="stats-card card-yellow">

            <h6>Low Stock</h6>

            <h2>@Model.LowStockOrOutOfStockCount</h2>

        </div>

    </div>


    <div class="col-md">

        <div class="stats-card card-cyan">

            <h6>Pending Receipts</h6>

            <h2>@Model.PendingReceiptsCount</h2>

        </div>

    </div>


    <div class="col-md">

        <div class="stats-card card-gray">

            <h6>Pending Deliveries</h6>

            <h2>@Model.PendingDeliveriesCount</h2>

        </div>

    </div>


    <div class="col-md">

        <div class="stats-card card-dark">

            <h6>Transfers Scheduled</h6>

            <h2>@Model.InternalTransfersScheduledCount</h2>

        </div>

    </div>

</div>