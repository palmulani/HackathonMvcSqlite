@model HackathonMvcSqlite.Models.Product
@{
    ViewData["Title"] = "New Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">New Product</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-2">
        <label class="form-label">Name *</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label class="form-label">SKU / Code *</label>
        <input asp-for="Sku" class="form-control" />
        <span asp-validation-for="Sku" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label class="form-label">Category *</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">--</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label class="form-label">Unit of Measure *</label>
        <input asp-for="UnitOfMeasure" class="form-control" value="Unit" />
        <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label class="form-label">Reorder Level *</label>
        <input asp-for="ReorderLevel" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="ReorderLevel" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label class="form-label">Reorder Quantity *</label>
        <input asp-for="ReorderQuantity" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="ReorderQuantity" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label class="form-label">Initial stock (optional)</label>
        <input type="number" name="initialStock" step="0.01" class="form-control" placeholder="0" />
    </div>

    <div class="mb-2">
        <label class="form-label">Warehouse (for initial stock)</label>
        <select name="warehouseId" asp-items="ViewBag.Warehouses" class="form-select">
            <option value="">--</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a href="/Products" class="btn btn-secondary">Cancel</a>

</form>