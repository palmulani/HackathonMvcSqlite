<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoreInventory</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <style>
        body { display: flex; min-height: 100vh; }
        .sidebar { width: 240px; background: #0f172a; color: #e2e8f0; height: 100vh; padding: 1rem; position: fixed; }
        .sidebar a { display: block; color: #94a3b8; margin: 0.4rem 0; text-decoration: none; padding: 0.5rem; border-radius: 0.375rem; }
        .sidebar a:hover { background: #1e293b; color: white; }
        .sidebar .nav-section { font-size: 0.7rem; text-transform: uppercase; color: #64748b; margin-top: 1rem; margin-bottom: 0.25rem; }
        .content { flex: 1; margin-left: 240px; padding: 1.5rem; background: #f8fafc; }
        .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    </style>
</head>
<body>
    <div class="sidebar">
        <h5 class="text-white mb-3">CoreInventory</h5>
        <a href="/">Dashboard</a>
        <div class="nav-section">Products</div>
        <a href="/Products">Products</a>
        <a href="/Categories">Categories</a>
        <div class="nav-section">Operations</div>
        <a href="/Receipts">Receipts</a>
        <a href="/DeliveryOrders">Delivery Orders</a>
        <a href="/InternalTransfers">Internal Transfers</a>
        <a href="/Adjustments">Adjustments</a>
        <a href="/MoveHistory">Move History</a>
        <div class="nav-section">Settings</div>
        <a href="/Warehouses">Warehouses</a>
        <div class="nav-section">Profile</div>
        <a href="/Account/Logout" class="text-warning">Logout</a>
    </div>
    <div class="content">
        @RenderBody()
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
