<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CoreInventory</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>

            body {
                display: flex;
                min-height: 100vh;
                font-family: 'Segoe UI';
                background: #f1f5f9;
            }

            /* SIDEBAR */

            .sidebar {
                width: 240px;
                background: #0f172a;
                color: #e2e8f0;
                height: 100vh;
                padding: 1rem;
                position: fixed;
            }

                .sidebar a {
                    display: block;
                    color: #94a3b8;
                    margin: 0.4rem 0;
                    text-decoration: none;
                    padding: 0.5rem;
                    border-radius: 6px;
                    transition: 0.2s;
                }

                    .sidebar a:hover {
                        background: #2563eb;
                        color: white;
                    }

                .sidebar .nav-section {
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    color: #64748b;
                    margin-top: 1rem;
                    margin-bottom: 0.25rem;
                }

            .content {
                flex: 1;
                margin-left: 240px;
                padding: 1.5rem;
                background: #f8fafc;
            }

            /* CARD */

            .card {
                border: none;
                box-shadow: 0 4px 10px rgba(0,0,0,.08);
            }

            /* TABLE */

            table.dataTable thead {
                background: #2563eb;
                color: white;
            }

            /* SEARCH */

            .dataTables_filter input {
                border-radius: 8px;
                padding: 6px 10px;
                border: 1px solid #ddd;
            }

            .page-header {
                background: #0f172a;
                color: white;
                padding: 12px 18px;
                font-size: 20px;
                font-weight: 600;
                border-radius: 6px;
                margin-bottom: 20px;
            }

            .page-body {
                background: #ffffff;
                padding: 15px;
                border-radius: 6px;
                box-shadow: 0 4px 10px rgba(0,0,0,.08);
            }
    </style>

</head>

<body>

    <div class="sidebar">

        <h5 class="text-white mb-3">
            <i class="fa-solid fa-boxes-stacked"></i>
            CoreInventory
        </h5>

        <a href="/"><i class="fa fa-chart-line"></i> Dashboard</a>

        <div class="nav-section">Products</div>

        <a href="/Products"><i class="fa fa-box"></i> Products</a>
        <a href="/Categories"><i class="fa fa-tags"></i> Categories</a>

        <div class="nav-section">Operations</div>

        <a href="/Receipts"><i class="fa fa-arrow-down"></i> Receipts</a>
        <a href="/DeliveryOrders"><i class="fa fa-truck"></i> Delivery Orders</a>
        <a href="/InternalTransfers"><i class="fa fa-right-left"></i> Internal Transfers</a>
        <a href="/Adjustments"><i class="fa fa-sliders"></i> Adjustments</a>
        <a href="/MoveHistory"><i class="fa fa-clock-rotate-left"></i> Move History</a>

        <div class="nav-section">Settings</div>

        <a href="/Warehouses"><i class="fa fa-warehouse"></i> Warehouses</a>

        <div class="nav-section">Profile</div>

        <a href="/Account/Logout" class="text-warning">
            <i class="fa fa-right-from-bracket"></i>
            Logout
        </a>

    </div>


    <div class="content">

        <div class="page-header">
            @ViewData["Title"]
        </div>

        <div class="page-body">
            @RenderBody()
        </div>

    </div>


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>


    <script>

        $(document).ready(function () {

        // Only tables with class 'datatable' will use DataTables

        $(".datatable").DataTable({

        pageLength: 10,

        responsive: true,

        language: {
        search: "🔎 Search:",
        lengthMenu: "Show _MENU_ entries",
        info: "Showing _START_ to _END_ of _TOTAL_ entries"
        }

        });

        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
