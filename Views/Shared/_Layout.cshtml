<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>@ViewData["Title"] - CoreInventory</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>

            body {
                display: flex;
                font-family: Segoe UI;
                background: #f1f5f9;
            }

            /* SIDEBAR */

            .sidebar {
                width: 240px;
                background: #0f172a;
                height: 100vh;
                color: white;
                position: fixed;
                padding: 20px;
            }

                .sidebar a {
                    display: block;
                    color: #94a3b8;
                    text-decoration: none;
                    padding: 8px;
                    margin-bottom: 5px;
                    border-radius: 6px;
                }

                    .sidebar a:hover {
                        background: #2563eb;
                        color: white;
                    }

            /* CONTENT */

            .content {
                margin-left: 240px;
                padding: 25px;
                width: 100%;
            }

            /* HEADER */

            .page-header {
                background: #0f172a;
                color: white;
                padding: 12px 20px;
                border-radius: 8px;
                margin-bottom: 20px;
                font-size: 20px;
                font-weight: 600;
            }

            /* CARDS */

            .stats-card {
                border: none;
                border-radius: 12px;
                padding: 20px;
                color: white;
                min-height: 110px;
                box-shadow: 0 4px 10px rgba(0,0,0,.1);
            }

            .card-blue {
                background: linear-gradient(135deg,#2563eb,#1e40af);
            }

            .card-yellow {
                background: linear-gradient(135deg,#f59e0b,#d97706);
            }

            .card-cyan {
                background: linear-gradient(135deg,#06b6d4,#0891b2);
            }

            .card-gray {
                background: linear-gradient(135deg,#6b7280,#4b5563);
            }

            .card-dark {
                background: linear-gradient(135deg,#1f2937,#111827);
            }
    </style>

</head>

<body>

    <div class="sidebar">

        <h5>
            <i class="fa fa-boxes-stacked"></i>
            CoreInventory
        </h5>

        <a href="/">Dashboard</a>

        <h6 class="mt-3">Products</h6>

        <a href="/Products">Products</a>

        <a href="/Categories">Categories</a>

        <h6 class="mt-3">Operations</h6>

        <a href="/Receipts">Receipts</a>

        <a href="/DeliveryOrders">Delivery Orders</a>

        <a href="/InternalTransfers">Transfers</a>

        <a href="/Adjustments">Adjustments</a>

        <a href="/MoveHistory">Move History</a>

        <h6 class="mt-3">Settings</h6>

        <a href="/Warehouses">Warehouses</a>

    </div>


    <div class="content">

        <div class="page-header">
            @ViewData["Title"]
        </div>

        @RenderBody()

    </div>

</body>

</html>